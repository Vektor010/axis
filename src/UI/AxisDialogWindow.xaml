<Window x:Class="WinTweaker.UI.AxisDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="560"
        MaxWidth="720"
        MinHeight="200"
        FontFamily="{StaticResource FontUI}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Background="{DynamicResource SidebarBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Dialog Title Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    Padding="18,13"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            x:Name="IconBadgeBorder"
                            Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="{DynamicResource AccentFill}"
                            BorderBrush="{DynamicResource AccentBorder}"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyphText"
                                   Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="AXIS"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   Text="Системное уведомление"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Click="CancelButton_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Width="28"
                            Height="28"
                            Padding="0"
                            ToolTip="Закрыть">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="440"
                          Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="MessageText"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               LineHeight="19" />

                    <!-- Optional Key-Value Inspector Grid -->
                    <Border x:Name="MetadataBorder"
                            Visibility="Collapsed"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,12,0,0">
                        <StackPanel x:Name="MetadataPanel" />
                    </Border>

                    <!-- Optional High-Risk Guard CheckBox -->
                    <Border x:Name="GuardOptionBorder"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningFill}"
                            BorderBrush="{DynamicResource WarningBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,12,0,0">
                        <CheckBox x:Name="GuardOptionCheckBox"
                                  Style="{StaticResource TachyonCheckBoxStyle}"
                                  FontSize="11.5"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource WarningBrush}"
                                  Content="Включить также настройки повышенного риска / защиты ОС" />
                    </Border>

                    <!-- Optional Items Preview List (Batch operations / Conflicts / Logs) -->
                    <Border x:Name="ItemsBorder"
                            Visibility="Collapsed"
                            Background="{DynamicResource SearchBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,12,0,0"
                            MaxHeight="210">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,3" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,0.5">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource FontUI}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Click="SecondaryButton_Click"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="Откатить"
                            Padding="14,7"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <Button x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Content="Отмена"
                            Padding="14,7"
                            Height="32"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton"
                            Click="PrimaryButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Понятно"
                            Padding="16,7"
                            Height="32"
                            FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
