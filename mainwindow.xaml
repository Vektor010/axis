                                            </Grid>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Первоисточник" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="nohuto/win-config + app-guides" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Готовые PS1 скрипты" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
