                                        <TextBlock Text="БЫСТРОЕ УПРАВЛЕНИЕ И СОВЕТЫ" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Margin="0,3">
                                        <TextBlock Text="Мгновенный поиск по всем твикам" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
