<Window x:Class="WinTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AXIS — Оптимизатор Windows 10/11 (2026)"
        Height="800"
        Width="1180"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource FontUI}"
        Icon="Resources/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Floating Sidebar Column -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Content Area Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- FLOATING SIDEBAR (LEFT)                                  -->
        <!-- ======================================================== -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource SidebarBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Margin="12,12,6,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand / App Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Items -->
                    <RowDefinition Height="*" />
                    <!-- Bottom Status Pills -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header with App Title & Collapse Toggle -->
                <Border Grid.Row="0" Padding="14,16,14,14" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- VEKTOR Custom Vector Logo Badge -->
                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="10"
                                BorderThickness="1.2"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1F1842" Offset="0.0" />
                                    <GradientStop Color="#0D0C1B" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A78BFA" Offset="0.0" />
                                    <GradientStop Color="#22D3EE" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Viewbox Width="22" Height="22" Stretch="Uniform">
                                <Canvas Width="64" Height="64">
                                    <Polygon Points="10,14 21,14 33,44 27,54">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#C4B5FD" Offset="0" />
                                                <GradientStop Color="#7C3AED" Offset="1" />
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>
                                    <Polygon Points="27,54 35,54 55,12 43,12">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Color="#6366F1" Offset="0" />
                                                <GradientStop Color="#22D3EE" Offset="1" />
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>
                                    <Polygon Points="32,12 37,20 32,28 27,20">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFFF" Offset="0" />
                                                <GradientStop Color="#67E8F9" Offset="1" />
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Title and Subtitle (Visible when sidebar is expanded) -->
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AXIS"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="4"
                                        Background="{DynamicResource AccentFill}"
                                        BorderBrush="{DynamicResource AccentBorder}"
                                        BorderThickness="0.8"
                                        Padding="4,0.5"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="2.0"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows Engine"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <!-- Collapse Button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource FluentButtonStyle}"
                                Command="{Binding ToggleSidebarCommand}"
                                Padding="6,4"
                                Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Navigation Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,12,8">
                    <StackPanel>
                        <!-- Main Nav Items (Overview, Tweaks with Nested Categories, Journal, History, Settings, About) -->
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Margin="0,2"
                                                CornerRadius="8"
                                                Cursor="Hand"
                                                Padding="10,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Fluent 2 Active Indicator Pill -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        Height="15"
                                                        CornerRadius="1.5"
                                                        Margin="-4,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#A78BFA" Offset="0" />
                                                            <GradientStop Color="#22D3EE" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Icon -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding IconGlyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Width="22" />

                                                <!-- Name -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                                <!-- Counter Badge & Tweaks Chevron -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource FluentButtonStyle}"
                                                            Command="{Binding DataContext.ToggleTweaksCategoriesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Padding="2"
                                                            Height="20"
                                                            Width="20"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding IsTweaksItem, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Свернуть/развернуть категории">
                                                        <TextBlock Text="{Binding DataContext.TweaksChevronGlyph, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Button>

                                                    <Border CornerRadius="10"
                                                            Background="{DynamicResource BadgeBg}"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Count}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Sub-categories: Accordion directly under Tweaks item -->
                                        <Border Visibility="{Binding IsTweaksItem, Converter={StaticResource BoolToVis}}">
                                            <Border Visibility="{Binding DataContext.IsSubcategoriesVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                    Margin="12,2,0,4">
                                                <ItemsControl ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,1"
                                                                    CornerRadius="6"
                                                                    Cursor="Hand"
                                                                    Padding="8,5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AccentFill}" />
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  CommandParameter="{Binding}" />
                                                                </Border.InputBindings>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding IconGlyph}"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Width="18" />

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Name}"
                                                                               FontSize="11.5"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6,0,0,0"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Count}"
                                                                               FontSize="10.5"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6,0,0,0"
                                                                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Bottom Status Pills (Mode + Admin) -->
                <Border Grid.Row="2"
                        Padding="12,14"
                        BorderBrush="{DynamicResource SidebarBorder}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Mode Pill -->
                        <Border Background="{DynamicResource BadgeBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,4"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ModePillText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Admin Pill -->
                        <Border Background="{DynamicResource BadgeBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,4"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding AdminPillText}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- MAIN CONTENT AREA (RIGHT)                                -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1" Margin="6,12,12,12">
            <Grid.RowDefinitions>
                <!-- 0. Top Rounded Header Bar -->
                <RowDefinition Height="Auto" />
                <!-- 1. Screen Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 0. Top Bar: Screen Title, Center Search (360-480px), Theme Switcher -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Screen Title -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center: Search Box -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Theme Switcher -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Screen Title -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedNavItem.Name}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- Search Input Box (Center, Interactive Focus & Width Animation) -->
                    <Border x:Name="SearchBorderContainer"
                            Grid.Column="1"
                            Width="380"
                            Height="32"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="IBeam"
                            MouseLeftButtonDown="SearchBorderContainer_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SearchBg}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SearchBorder}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBg}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Search Magnifier Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <!-- Watermark / Placeholder -->
                            <TextBlock Grid.Column="1"
                                       Text="Поиск твиков"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchQuery}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- TextBox -->
                            <TextBox x:Name="SearchBoxControl"
                                     Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     FontSize="12"
                                     VerticalAlignment="Center" />
                            <!-- Raycast/Linear Ctrl+K Shortcut Hint (when search is empty) -->
                            <Border Grid.Column="2"
                                    CornerRadius="4"
                                    Background="{DynamicResource BadgeBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Ctrl K"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <!-- Clear Button (Cross) -->
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Style="{StaticResource FluentButtonStyle}"
                                    Padding="4,2"
                                    Height="22"
                                    Width="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    ToolTip="Очистить поиск"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Theme Switcher Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource FluentButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            VerticalAlignment="Center"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeButtonIcon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ThemeButtonText}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 1. Screens -->
            <Grid Grid.Row="1">
                <!-- ==================================================== -->
                <!-- SCREEN: ОБЗОР (OVERVIEW)                             -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsOverviewSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,4,0">
                        <!-- 2.1 Four Bento Metric Cards Row (2026 Typography + Icon Badges) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Metric 1: ТЕМПЕРАТУРА -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,6,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ТЕМПЕРАТУРА" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource WarningFill}" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xE9CA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,6,0,6">
                                        <TextBlock Text="{Binding TempDisplay}" FontFamily="{StaticResource FontDisplay}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Polyline Points="{Binding TempSparkline}" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.8" HorizontalAlignment="Right" VerticalAlignment="Center" Width="84" Height="26" />
                                    </Grid>
                                    <TextBlock Text="{Binding TempStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: ЗАГРУЗКА -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="6,0,6,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ЗАГРУЗКА ЦП" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentFill}" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,6,0,6">
                                        <TextBlock Text="{Binding CpuDisplay}" FontFamily="{StaticResource FontDisplay}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Polyline Points="{Binding CpuSparkline}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="84" Height="26" />
                                    </Grid>
                                    <TextBlock Text="{Binding CpuStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: ЗАДЕРЖКА -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="6,0,6,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ЗАДЕРЖКА ПИНГА" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SuccessFill}" HorizontalAlignment="Right">
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PingDisplay}" FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                        <Polyline Grid.Column="1" Points="{Binding PingSparkline}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="64" Height="26" />
                                    </Grid>
                                    <TextBlock Text="{Binding PingStatus}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: ТВИКИ + Прогресс-бар оптимизации -->
                            <Border Grid.Column="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="АКТИВНЫЕ ТВИКИ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Border CornerRadius="6" Background="{DynamicResource CyanFill}" Padding="6,1.5" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding OptimizationPercentText}" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding TweaksDisplay}" FontFamily="{StaticResource FontDisplay}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding TweaksStatus}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding OptimizationPercent, Mode=OneWay}" Minimum="0" Maximum="100" Style="{StaticResource VektorProgressBarStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.2 Two-Column Row: Big 60s Chart (Left) + System Specs (Right) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Big 60-second Chart -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,6,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="НАГРУЗКА ЗА ПОСЛЕДНИЕ 60 СЕКУНД" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding ChartTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Chart Canvas Area -->
                                    <Border Background="{DynamicResource SearchBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Height="130" Padding="6">
                                        <Grid>
                                            <Polyline Points="{Binding CpuChartPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" />
                                            <Polyline Points="{Binding RamChartPoints}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.5" />
                                            <Border Visibility="{Binding IsCollectingData, Converter={StaticResource BoolToVis}}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Сбор метрик в реальном времени..." FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Chart Legend -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Rectangle Width="10" Height="10" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Загрузка ЦП" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0" />

                                        <Rectangle Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Память (RAM)" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- System Specs Card -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="СИСТЕМА" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CopySpecsFeedback}" FontSize="10.5" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource FluentButtonStyle}"
                                                    Command="{Binding CopySpecsCommand}"
                                                    Padding="7,2"
                                                    FontSize="10.5"
                                                    ToolTip="Скопировать полную конфигурацию ПК в буфер обмена">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="Копировать" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Процессор" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CpuSpec}" ToolTip="{Binding CpuSpec}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Плата" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MotherboardSpec}" ToolTip="{Binding MotherboardSpec}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Видеокарта" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GpuSpec}" ToolTip="{Binding GpuSpec}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Память" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RamSpec}" ToolTip="{Binding RamSpec}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Диски" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisksSpec}" ToolTip="{Binding DisksSpec}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="ОС" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OsSpec}" ToolTip="{Binding OsSpec}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.25 Native Kernel Subsystems Bento Row (WDDM HAGS / Flip Queue / MMCSS / WNF Game Mode) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="GPU HAGS (WDDM 2.9)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding HagsStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CyanAccentBrush}" Margin="0,4,0,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Аппаратное планирование" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="FLIP QUEUE (WDDM 3.0)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding FlipQueueStatusText}" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="Аппаратная очередь кадров" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="6,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="MMCSS • ПЛАНИРОВЩИК" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,1">
                                        <TextBlock Text="{Binding MmcssRespText}" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MmcssTasksText}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding MmcssThrottlingText}" ToolTip="{Binding MmcssThrottlingText}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GAME MODE (WNF)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding GameModeShortStatus}" ToolTip="{Binding GameModeStatusSummary}" FontFamily="{StaticResource FontDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GameModePowerProfileDisplay, StringFormat='Профиль WNF: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2.3 Row of Status Pills: СОСТОЯНИЕ -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pill 1: Защита системы -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Защита системы:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" />
                                    <Border CornerRadius="8" Background="{DynamicResource BadgeBg}" Padding="6,2">
                                        <TextBlock Text="{Binding SystemRestoreStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SystemRestoreStatusBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Pill 2: Точка восстановления -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Точка восстановления:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" />
                                    <Border CornerRadius="8" Background="{DynamicResource BadgeBg}" Padding="6,2">
                                        <TextBlock Text="{Binding LastRestorePointDisplay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    </Border>
                                </StackPanel>

                                <!-- Pill 3: Режим -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Режим:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" />
                                    <Border CornerRadius="8" Background="{DynamicResource BadgeBg}" Padding="6,2">
                                        <TextBlock Text="{Binding EngineModeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Pill 4: Журнал -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Журнал:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0" />
                                    <Border CornerRadius="8" Background="{DynamicResource BadgeBg}" Padding="6,2">
                                        <TextBlock Text="{Binding JournalCountDisplay}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2.4 Bottom Two Cards: Последние действия & Требуют внимания -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Последние действия -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ПОСЛЕДНИЕ ДЕЙСТВИЯ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                                    <TextBlock Text="Действий пока нет" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4" Visibility="{Binding HasRecentJournalActions, Converter={StaticResource InverseBoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding RecentJournalEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Width="55" />
                                                    <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource BadgeBg}" Padding="4,1" Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding Level}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Требуют внимания -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding AttentionSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,8" />
                                    <TextBlock Text="Для этих твиков в источнике нет описания или ключ требует ручной сверки." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <Button Style="{StaticResource FluentButtonStyle}" Command="{Binding NavigateAttentionCommand}" Content="Открыть список" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== -->
                <!-- SCREEN: ТВИТЫ (TWEAKS)                               -->
                <!-- ==================================================== -->
                <Grid Visibility="{Binding IsTweaksSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <!-- Screen Toolbar (Segments, Summary, Batch Buttons) -->
                        <RowDefinition Height="Auto" />
                        <!-- Grouped & Virtualized List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tweaks Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Segmented Filter (Left) + Batch Action Buttons (Right) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Modern 2026 Segmented Filter Control -->
                                <Border Grid.Column="0" Background="{DynamicResource SearchBg}" BorderBrush="{DynamicResource SearchBorder}" BorderThickness="1" CornerRadius="8" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="{Binding SegmentAllText}"
                                                     IsChecked="{Binding IsFilterAll}"
                                                     Style="{StaticResource SegmentRadioButtonStyle}" />
                                        <RadioButton Content="{Binding SegmentEnabledText}"
                                                     IsChecked="{Binding IsFilterEnabled}"
                                                     Style="{StaticResource SegmentRadioButtonStyle}" />
                                        <RadioButton Content="{Binding SegmentDisabledText}"
                                                     IsChecked="{Binding IsFilterDisabled}"
                                                     Style="{StaticResource SegmentRadioButtonStyle}" />
                                        <RadioButton Content="{Binding SegmentNeedsReviewText}"
                                                     IsChecked="{Binding IsFilterNeedsReview}"
                                                     Style="{StaticResource SegmentRadioButtonStyle}" />
                                    </StackPanel>
                                </Border>

                                <!-- Batch Buttons with Icons and Compact 2026 Style -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding ApplyAllRecommendedCommand}"
                                            IsEnabled="{Binding CanApplyRecommended}"
                                            ToolTip="{Binding ApplyRecommendedToolTip}"
                                            Padding="10,5"
                                            FontSize="11.5"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="Применить рекомендуемые"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding RevertAllCommand}"
                                            Padding="10,5"
                                            FontSize="11.5"
                                            ToolTip="Откатить все применённые твики до исходного состояния">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="Откатить всё"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Search Summary (Left) + Sort ComboBox + Grouping Toggle (Right) -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding SearchSummaryText}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Сортировка:"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SelectedSortOption}"
                                              Style="{StaticResource TachyonComboBoxStyle}"
                                              Width="165"
                                              Height="26"
                                              FontSize="11.5"
                                              VerticalAlignment="Center"
                                              Margin="0,0,14,0" />

                                    <CheckBox Content="Группировать"
                                              IsChecked="{Binding IsGrouped}"
                                              Style="{StaticResource TachyonCheckBoxStyle}"
                                              FontSize="11.5"
                                              Foreground="{DynamicResource TextPrimary}"
                                              VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Grouped & Virtualized Tweak Cards List + Empty State -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding FilteredTweaksView}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander Style="{StaticResource TachyonGroupExpanderStyle}"
                                                                  IsExpanded="True"
                                                                  Loaded="GroupExpander_Loaded"
                                                                  Expanded="GroupExpander_Expanded"
                                                                  Collapsed="GroupExpander_Collapsed">
                                                            <Expander.Header>
                                                                <Grid Margin="2,3,6,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Name}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               VerticalAlignment="Center" />
                                                                    <Border Grid.Column="1"
                                                                            CornerRadius="8"
                                                                            Background="{DynamicResource BadgeBg}"
                                                                            Padding="6,1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ItemCount}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding Converter={StaticResource GroupToEnabledCountConverter}}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Expander.Header>
                                                            <ItemsPresenter Margin="0,2,0,4" />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,3"
                                            Padding="10,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBg}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBgHover}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Sleek Compact High-Density Row -->
                                            <Grid MinHeight="26">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Title, Badges, and 1-line Description -->
                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Cursor="Hand"
                                                            Background="Transparent">
                                                    <StackPanel.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}" />
                                                    </StackPanel.InputBindings>
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />

                                                        <!-- Risk Badge (Shown ONLY for Medium and High) -->
                                                        <Border CornerRadius="4"
                                                                Background="{DynamicResource BadgeBg}"
                                                                Padding="5,1"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0"
                                                                Visibility="{Binding ShowRiskBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding RiskText}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding RiskColor}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- 1-line Description (Hidden if empty) -->
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Right: Status Badge & Live Switch & Expand Chevron -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadgeText}"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- Action Button (for cleanup / one-time actions) -->
                                                    <Button Style="{StaticResource AccentButtonStyle}"
                                                            Command="{Binding ExecuteActionCommand}"
                                                            Padding="10,3"
                                                            Height="24"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0"
                                                            Visibility="{Binding IsActionTweak, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Выполнить очистку">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding ActionButtonText}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Toggle Switch (for persistent configuration tweaks) -->
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Template="{StaticResource FluentToggleSwitchTemplate}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"
                                                              Visibility="{Binding IsToggleTweak, Converter={StaticResource BoolToVis}}" />

                                                    <!-- Expand / Collapse Button -->
                                                    <Button Style="{StaticResource FluentButtonStyle}"
                                                            Command="{Binding ToggleExpandCommand}"
                                                            Padding="2"
                                                            Height="22"
                                                            Width="22"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Развернуть/свернуть подробности">
                                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource TextSecondary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE70E;" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Expanded Details Area -->
                                            <Border Margin="0,6,0,0"
                                                    Padding="10,8"
                                                    Background="{DynamicResource SearchBg}"
                                                    BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <!-- Full Needs Review Banner in Expanded Part -->
                                                    <Border CornerRadius="5"
                                                            Background="{DynamicResource WarningFill}"
                                                            BorderBrush="{DynamicResource WarningBorder}"
                                                            BorderThickness="1"
                                                            Padding="8,5"
                                                            Margin="0,0,0,8"
                                                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7BA;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource WarningBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                                            <TextBlock Text="Требует проверки: значение параметра в реестре отличается от ожидаемого"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource WarningBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Full Description / Quote -->
                                                    <TextBlock Text="{Binding ExpandedDescription}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,6" />

                                                    <!-- Technical Details -->
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="Путь в реестре:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding RegistryPath}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="Имя параметра:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding RegistryName}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="Применение:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding RegistryApplyText}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="Значение отката:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding RegistryRevertText}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="Ссылка на источник:" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock Text="{Binding SourceLocation}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <!-- Revert Button (for Toggle tweaks) -->
                                                    <Button Style="{StaticResource DangerButtonStyle}"
                                                            Command="{Binding RevertTweakCommand}"
                                                            Content="Откатить твик"
                                                            IsEnabled="{Binding CanRevert}"
                                                            ToolTip="{Binding RevertToolTip}"
                                                            HorizontalAlignment="Right"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsToggleTweak, Converter={StaticResource BoolToVis}}" />

                                                    <!-- Execute Action Button (for Cleanup tweaks) -->
                                                    <Button Style="{StaticResource AccentButtonStyle}"
                                                            Command="{Binding ExecuteActionCommand}"
                                                            HorizontalAlignment="Right"
                                                            Padding="12,4"
                                                            FontSize="11"
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsActionTweak, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Запустить процедуру очистки">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding DetailsActionButtonText}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty Search Results State Card -->
                    <Border Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32,28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Ничего не найдено"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="По вашему запросу не найдено ни одного твика. Попробуйте изменить формулировку или сбросить фильтры поиска."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16" />
                            <Button Style="{StaticResource FluentButtonStyle}"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="Сбросить поиск"
                                    HorizontalAlignment="Center"
                                    Padding="16,6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

                <!-- ==================================================== -->
                <!-- SCREEN: ЖУРНАЛ (JOURNAL)                             -->
                <!-- ==================================================== -->
                <Grid Visibility="{Binding IsJournalSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Журнал операций и аудит реестра" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource FluentButtonStyle}" Command="{Binding ClearJournalCommand}" Content="Очистить журнал" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <DataGrid ItemsSource="{Binding JournalEntries}"
                                      Style="{StaticResource TachyonDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ВРЕМЯ" Width="120" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" />
                                    <DataGridTextColumn Header="УРОВЕНЬ" Width="90" Binding="{Binding Level}" />
                                    <DataGridTextColumn Header="ID ТВИКА" Width="200" Binding="{Binding TweakId}" />
                                    <DataGridTextColumn Header="СООБЩЕНИЕ" Width="*" Binding="{Binding Message}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Centered Empty Placeholder -->
                            <TextBlock Text="Записей пока нет"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasJournalEntries}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- SCREEN: ИСТОРИЯ (HISTORY)                            -->
                <!-- ==================================================== -->
                <Grid Visibility="{Binding IsHistorySelected, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <TextBlock Text="История применённых твиков и снимков состояния" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <DataGrid ItemsSource="{Binding HistoryItems}"
                                      Style="{StaticResource TachyonDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID ТВИКА" Width="260" Binding="{Binding TweakId}" />
                                    <DataGridTextColumn Header="ДАТА ПРИМЕНЕНИЯ (UTC)" Width="200" Binding="{Binding AppliedAt}" />
                                    <DataGridTextColumn Header="ДЕТАЛИ СНИМКА" Width="*" Binding="{Binding Details}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Centered Empty Placeholder -->
                            <TextBlock Text="Записей пока нет"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHistoryItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- SCREEN: НАСТРОЙКИ (SETTINGS)                         -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Setting Card: Network Ping -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="СЕТЕВАЯ ЗАДЕРЖКА (ПИНГ)" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="Адрес узла для измерения сетевой задержки на экране «Обзор». По умолчанию используется адрес шлюза." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource SearchBg}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,0"
                                            Width="320"
                                            Height="34"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SearchBorder}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocused, ElementName=PingHostTextBox}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid VerticalAlignment="Center">
                                            <!-- Watermark / Placeholder -->
                                            <TextBlock Text="Пусто: до шлюза по умолчанию"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PingHostTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="PingHostTextBox"
                                                     Text="{Binding PingCustomHost, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     FontSize="12"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}" Content="Сохранить" Margin="10,0,0,0" VerticalAlignment="Center" Height="34" />
                                </StackPanel>
                                <TextBlock Text="Подсказка: Оставьте пустым для автоматического пинга шлюза по умолчанию." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SettingsSaveNotification}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Setting Card: Font Smoothing -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="СГЛАЖИВАНИЕ ТЕКСТА" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="Выбор режима рендеринга шрифтов в интерфейсе. Изменение применяется немедленно и сохраняется в настройках." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="ClearType (Субпиксельное)"
                                                 GroupName="TextRenderingGroup"
                                                 IsChecked="{Binding IsClearTypeRendering, Mode=TwoWay}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 FontSize="12"
                                                 Margin="0,0,20,0"
                                                 VerticalAlignment="Center" />
                                    <RadioButton Content="Градации серого (Grayscale)"
                                                 GroupName="TextRenderingGroup"
                                                 IsChecked="{Binding IsGrayscaleRendering, Mode=TwoWay}"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Setting Card: Engine Mode -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="РЕЖИМ РАБОТЫ ДВИЖКА" Style="{StaticResource CardHeaderStyle}" />
                                <TextBlock Text="Прямой рабочий режим: все выбранные оптимизации применяются непосредственно к конфигурации системы и реестру Windows с возможностью мгновенного отката." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== -->
                <!-- SCREEN: О ПРОГРАММЕ (ABOUT — VEKTOR 2026 BENTO)      -->
                <!-- ==================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsAboutSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,4,12">
                        <!-- Hero Brand Card -->
                        <Border Background="{DynamicResource HeroCardBg}"
                                BorderBrush="{DynamicResource AccentBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24,22"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Large Authorial VEKTOR Vector Emblem (64x64) -->
                                <Border Grid.Column="0"
                                        Width="64"
                                        Height="64"
                                        CornerRadius="16"
                                        BorderThickness="1.6"
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#231B4A" Offset="0.0" />
                                            <GradientStop Color="#0C0B19" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#A78BFA" Offset="0.0" />
                                            <GradientStop Color="#22D3EE" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Viewbox Width="40" Height="40" Stretch="Uniform">
                                        <Canvas Width="64" Height="64">
                                            <Polygon Points="10,14 21,14 33,44 27,54">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#C4B5FD" Offset="0" />
                                                        <GradientStop Color="#7C3AED" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>
                                            <Polygon Points="27,54 35,54 55,12 43,12">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="#6366F1" Offset="0" />
                                                        <GradientStop Color="#22D3EE" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>
                                            <Polygon Points="32,12 37,20 32,28 27,20">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                                        <GradientStop Color="#67E8F9" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Brand Title, Badges & Tagline -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="AXIS"
                                                   FontFamily="{StaticResource FontDisplay}"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="6" Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="v2.0.0 • 2026" FontFamily="{StaticResource FontMono}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border CornerRadius="6" Background="{DynamicResource SuccessFill}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="7760 тестов PASS" FontFamily="{StaticResource FontMono}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Современный нативный оптимизатор ядра, сетевого стека, GPU и приватности Windows 10/11 с мгновенным откатом по снимкам состояния."
                                               FontSize="12.5"
