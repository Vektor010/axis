                                                FontSize="11"
                                                Margin="0,0,6,0"
                                                Content="Noverse Docs" />
                                        <Button Style="{StaticResource FluentButtonStyle}"
                                                Command="{Binding OpenUrlCommand}"
                                                CommandParameter="https://github.com/Vektor010/axis/releases"
