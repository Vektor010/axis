                                            <TextBlock Text="Ctrl + K  /  Ctrl + F" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Ключи реестра и ссылка на источник" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" CornerRadius="4" Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="6,2">
                                            <TextBlock Text="Клик по карточке" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,3">
