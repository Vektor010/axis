                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentFill}" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="АРХИТЕКТУРА И СБОРКА" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource SearchBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Версия ядра" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
