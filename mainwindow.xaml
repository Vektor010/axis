                                            <TextBlock Text="Обзор → Копировать" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Сверка с GitHub автора (CLI)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
