                                            <Grid Margin="0,3">
                                                <TextBlock Text="Целостность базы" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="SHA-256 Embedded Verified" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Bento Row 2: Key Capabilities & Keyboard Shortcuts -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 3: Core Capabilities -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource CyanFill}" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
