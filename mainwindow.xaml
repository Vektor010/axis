                                            <Grid Margin="0,3">
                                                <TextBlock Text="Стиль и рендер" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="Fluent 2 • Graphite Blue • DWM Native" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource CyanAccentBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Размер дистрибутива" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="~1.4 МБ (без зависимостей)" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Нативные модули" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="WDDM • WNF • MMCSS • NVML • NVDRS" FontFamily="{StaticResource FontMono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Database & Verification -->
                            <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="6,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource SuccessFill}" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="БАЗА ТВИКОВ И ВЕРИФИКАЦИЯ" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource SearchBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="Всего оптимизаций" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
