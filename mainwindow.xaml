                                            <TextBlock Text="sync-upstream.ps1" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource CyanAccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource SearchBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                        <TextBlock Text="Автор сборки: Vektor010 • База знаний: Noverse (nohuto/win-config) • Открытый исходный код"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
